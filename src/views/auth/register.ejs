<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tạo tài khoản Laptopshop" />
    <title>Đăng ký | Laptopshop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"
    />
    <link href="/client/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/client/css/style.css" rel="stylesheet" />
    <link href="/client/css/modern.css" rel="stylesheet" />
    <link href="/client/css/auth.css" rel="stylesheet" />
  </head>
  <body class="storefront auth-page">
    <%- include('../client/layout/header') -%>
    <main class="auth-main">
      <div class="container">
        <div class="auth-shell">
          <aside class="auth-story" aria-label="Giới thiệu Laptopshop">
            <div class="auth-story-content">
              <span class="auth-story-kicker"
                ><i class="fas fa-star" aria-hidden="true"></i> LAPTOPSHOP
                ACCOUNT</span
              >
              <h2>Bắt đầu hành trình <span>của riêng bạn.</span></h2>
              <p>
                Tạo tài khoản để có một điểm khởi đầu cho trải nghiệm tại
                Laptopshop.
              </p>
              <div class="auth-illustration" aria-hidden="true">
                <div class="auth-illustration-ring"></div>
                <div class="auth-illustration-card">
                  <span><i class="fas fa-user-plus"></i></span>
                  <div>
                    <strong>Một tài khoản mới</strong
                    ><small>Sẵn sàng cho hành trình mới</small>
                  </div>
                  <i class="fas fa-arrow-up"></i>
                </div>
              </div>
              <span class="auth-story-footnote"
                >Tạo tài khoản chỉ trong vài bước</span
              >
            </div>
          </aside>
          <section class="auth-form-panel" aria-labelledby="register-title">
            <div class="auth-form-wrap">
              <span class="auth-form-kicker">TẠO TÀI KHOẢN</span>
              <h1 id="register-title">Tham gia Laptopshop.</h1>
              <p class="auth-form-intro">Điền thông tin dưới đây để bắt đầu.</p>
              <% if (typeof errors !== 'undefined' && Array.isArray(errors) && errors.length) { %>
                <div class="auth-errors" role="alert" aria-live="polite">
                  <strong>Vui lòng kiểm tra lại thông tin:</strong>
                  <ul>
                    <% errors.forEach((error) => { %>
                      <li><%= error %></li>
                    <% }); %>
                  </ul>
                </div>
              <% } %>
              <form class="auth-form" action="/register" method="post">
                <div class="auth-field">
                  <label for="register-full-name">Họ và tên</label>
                  <div class="auth-input-wrap">
                    <i class="fas fa-user" aria-hidden="true"></i
                    ><input
                      id="register-full-name"
                      name="fullName"
                      type="text"
                      value="<%= typeof oldData !== 'undefined' && oldData ? (oldData.fullName ?? '') : '' %>"
                      placeholder="Nguyễn Văn A"
                      autocomplete="name"
                      required
                    />
                  </div>
                </div>
                <div class="auth-field">
                  <label for="register-email">Email</label>
                  <div class="auth-input-wrap">
                    <i class="fas fa-envelope" aria-hidden="true"></i
                    ><input
                      id="register-email"
                      name="username"
                      type="email"
                      value="<%= typeof oldData !== 'undefined' && oldData ? (oldData.username ?? '') : '' %>"
                      placeholder="you@example.com"
                      required
                    />
                  </div>
                </div>
                <div class="auth-field">
                  <label for="register-password">Mật khẩu</label>
                  <div class="auth-input-wrap">
                    <i class="fas fa-lock" aria-hidden="true"></i
                    ><input
                      id="register-password"
                      name="password"
                      type="password"
                      placeholder="Nhập mật khẩu"
                      autocomplete="new-password"
                      required
                    />
                  </div>
                </div>
                <div class="auth-field">
                  <label for="register-confirm-password"
                    >Xác nhận mật khẩu</label
                  >
                  <div class="auth-input-wrap">
                    <i class="fas fa-shield-alt" aria-hidden="true"></i
                    ><input
                      id="register-confirm-password"
                      name="confirmPassword"
                      type="password"
                      placeholder="Nhập lại mật khẩu"
                      autocomplete="new-password"
                      required
                    />
                  </div>
                </div>
                <button class="auth-submit" type="submit">
                  Tạo tài khoản
                  <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </button>
              </form>
              <p class="auth-switch">
                Đã có tài khoản?
                <a href="/login"
                  >Đăng nhập
                  <i class="fas fa-arrow-right" aria-hidden="true"></i
                ></a>
              </p>
            </div>
          </section>
        </div>
      </div>
    </main>
    <%- include('../client/layout/footer') -%>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta name="description" content="Dự án laptopshop" />
    <title>Chỉnh sửa sản phẩm | Laptopshop</title>
    <link href="/admin/css/styles.css" rel="stylesheet" />
    <link href="/admin/css/modern.css" rel="stylesheet" />
    <script
      src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"
      crossorigin="anonymous"
    ></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script>
      $(document).ready(() => {
        const imageFile = $("#imageFile");
        imageFile.change(function (e) {
          const imgURL = URL.createObjectURL(e.target.files[0]);
          $("#imagePreview").attr("src", imgURL);
          $("#imagePreview").css({ display: "block" });
        });
      });
    </script>
  </head>

  <body class="sb-nav-fixed admin-product">
    <%- include('../layout/header') -%>

    <div id="layoutSidenav">
      <%- include('../layout/sidenav') -%>
      <div id="layoutSidenav_content">
        <main>
          <div class="container-fluid px-4">
            <div class="admin-page-heading"><span class="admin-eyebrow">QUẢN LÝ</span><h1>Chỉnh sửa sản phẩm</h1><p>Cập nhật thông tin hiện có.</p></div>
            <ol class="breadcrumb mb-4">
              <li class="breadcrumb-item"><a href="/admin">Bảng điều khiển</a></li>
              <li class="breadcrumb-item active">
                <a href="/admin/product">Sản phẩm</a>
              </li>
            </ol>
            <div class="row">
              <div class="col-12 col-xl-9 mx-auto">
                <div class="admin-form-card">
                  <% if (typeof errors !== "undefined" && Array.isArray(errors) && errors.length) { %>
                    <div class="alert alert-danger mb-3" role="alert">
                      <strong>Vui lòng kiểm tra lại thông tin:</strong>
                      <ul class="mb-0 mt-2 ps-3">
                        <% errors.forEach((error) => { %>
                          <li><%= error %></li>
                        <% }); %>
                      </ul>
                    </div>
                  <% } %>
                  <h5>Thông tin sản phẩm</h5>
                  <form
                    action="/admin/handle-update-product"
                    method="post"
                    enctype="multipart/form-data"
                  >
                  <div class="row">
                        <input type="hidden" name="id" value="<%= product.id %>">
                      <div class="mb-3 col-md-6">
                        <label class="form-label">Tên sản phẩm</label>
                        <input
                          value="<%= product.name%>"
                          name="name"
                          type="text"
                          class="form-control"
                        />
                      </div>
                      <div class="mb-3 col-md-6">
                        <label class="form-label">Giá bán (VND)</label>
                        <input
                          value="<%= product.price%>"
                          name="price"
                          type="number"
                          class="form-control"
                        />
                      </div>
                  </div>
                    <div class="mb-3">
                      <label class="form-label">Mô tả chi tiết</label>
                      <textarea name="detailDesc"
                        type="text"
                        class="form-control" rows="2" ><%= product.detailDesc%></textarea>    
                    </div>
                    <div class="row">
                      <div class="mb-3 col-md-6">
                        <label class="form-label">Mô tả ngắn</label>
                        <input
                          value="<%= product.shortDesc%>"
                          type="text"
                          class="form-control"
                          name="shortDesc"
                        />
                      </div>
                      <div class="mb-3 col-md-6">
                        <label class="form-label">Số lượng</label>
                        <input
                          value="<%= product.quantity%>"
                          name="quantity"
                          type="number"
                          class="form-control"
                      />
                    </div>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-md-6">
                        <label class="form-label">Hãng sản xuất</label>
                        <select name="factory" class="form-select">
                            <% factoryOptions.forEach((fact,index) => { %>
                            <option value="<%-fact.value %>" <%= fact.value === product.factory ? 'selected' : '' %>>
                              <%= fact.name %>
                            </option>
                            <%})%>
                        </select>
                    </div>
                        <div class="mb-3 col-md-6">
                            <label class="form-label">Nhu cầu sử dụng</label>
                            <select name="target" class="form-select">
                                 <% targetOptions.forEach((target,index) => { %>
                            <option value="<%-target.value %>" <%= target.value === product.target ? 'selected' : '' %>>
                              <%= target.name %>
                            </option>
                            <%})%>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                      <label for="imageFile" class="form-label">Hình ảnh</label>
                      <input
                        class="form-control"
                        type="file"
                        id="imageFile"
                        name="image"
                        accept=".png, .jpg, .jpeg"
                      />
                    </div>
                    <% if (product.image) { %>
                    <img
                      style="max-height: 250px; display: block"
                      alt="image preview"
                      id="imagePreview"
                      src="/images/product/<%= product.image %>"
                    />
                    <% } else { %>
                    <img
                      style="max-height: 250px; display: none"
                      alt="image preview"
                      id="imagePreview"
                    />
                    <% } %>
                    <div class="mb-3">
                      <button class="btn btn-primary mt-3" type="submit">
                        Lưu thay đổi
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </main>
        <%- include('../layout/footer') -%>
      </div>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
    <script src="/admin/js/scripts.js"></script>
  </body>
</html>

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta name="description" content="Dự án laptopshop" />
    <title>Bảng điều khiển | Laptopshop</title>
    <link href="/admin/css/styles.css" rel="stylesheet" />
    <link href="/admin/css/modern.css" rel="stylesheet" />
    <script
      src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"
      crossorigin="anonymous"
    ></script>
  </head>

  <body class="sb-nav-fixed admin-dashboard">
    <%- include('../layout/header') -%>

    <div id="layoutSidenav">
      <%- include('../layout/sidenav') -%>
      <div id="layoutSidenav_content">
        <main>
          <div class="container-fluid px-4">
            <!-- Tiêu đề trang & Ngày giờ hệ thống -->
            <div class="admin-page-heading d-flex justify-content-between align-items-center flex-wrap gap-3">
              <div>
                <span class="admin-eyebrow">TỔNG QUAN HỆ THỐNG</span>
                <h1>Bảng điều khiển</h1>
                <p>Theo dõi chỉ số hoạt động và quản lý tài nguyên của cửa hàng Laptopshop.</p>
              </div>
              <div>
                <span class="badge bg-white text-secondary border px-3 py-2 shadow-sm rounded-pill fw-semibold">
                  <i class="fas fa-calendar-alt text-primary me-1"></i>
                  <%= new Date().toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                </span>
              </div>
            </div>

            <!-- Khối thẻ chỉ số thống kê (Stats Metric Cards) -->
            <div class="row g-4 mb-4">
              <!-- Thẻ Người dùng -->
              <div class="col-md-6 col-xl-4">
                <a class="admin-stat-card" href="/admin/user" title="Xem danh sách người dùng">
                  <div class="admin-stat-header">
                    <span class="admin-stat-kicker">NGƯỜI DÙNG</span>
                    <span class="admin-stat-icon admin-stat-icon--user">
                      <i class="fas fa-users"></i>
                    </span>
                  </div>
                  <div class="admin-stat-number">
                    <%= (typeof info !== 'undefined' && info?.countUser !== undefined) ? info.countUser : 0 %>
                  </div>
                  <p class="admin-stat-desc">Tài khoản khách hàng &amp; quản trị viên</p>
                  <div class="admin-stat-footer">
                    <span>Xem danh sách người dùng</span>
                    <i class="fas fa-arrow-right"></i>
                  </div>
                </a>
              </div>

              <!-- Thẻ Sản phẩm -->
              <div class="col-md-6 col-xl-4">
                <a class="admin-stat-card" href="/admin/product" title="Xem danh mục sản phẩm">
                  <div class="admin-stat-header">
                    <span class="admin-stat-kicker">SẢN PHẨM</span>
                    <span class="admin-stat-icon admin-stat-icon--product">
                      <i class="fas fa-laptop"></i>
                    </span>
                  </div>
                  <div class="admin-stat-number">
                    <%= (typeof info !== 'undefined' && info?.countProduct !== undefined) ? info.countProduct : 0 %>
                  </div>
                  <p class="admin-stat-desc">Mặt hàng laptop đang kinh doanh</p>
                  <div class="admin-stat-footer">
                    <span>Quản lý kho sản phẩm</span>
                    <i class="fas fa-arrow-right"></i>
                  </div>
                </a>
              </div>

              <!-- Thẻ Đơn hàng -->
              <div class="col-md-6 col-xl-4">
                <a class="admin-stat-card" href="/admin/order" title="Xem danh sách đơn hàng">
                  <div class="admin-stat-header">
                    <span class="admin-stat-kicker">ĐƠN HÀNG</span>
                    <span class="admin-stat-icon admin-stat-icon--order">
                      <i class="fas fa-shopping-cart"></i>
                    </span>
                  </div>
                  <div class="admin-stat-number">
                    <%= (typeof info !== 'undefined' && info?.countOrder !== undefined) ? info.countOrder : 0 %>
                  </div>
                  <p class="admin-stat-desc">Đơn đặt hàng đã được ghi nhận</p>
                  <div class="admin-stat-footer">
                    <span>Theo dõi đơn đặt hàng</span>
                    <i class="fas fa-arrow-right"></i>
                  </div>
                </a>
              </div>
            </div>

            <!-- Bảng thao tác nhanh (Quick Actions) -->
            <div class="mb-4">
              <h5 class="fw-bold mb-3 text-secondary" style="font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase;">
                Lối tắt thao tác nhanh
              </h5>
              <div class="admin-quick-actions-bar">
                <a href="/admin/create-product" class="admin-quick-action">
                  <i class="fas fa-plus-circle text-primary"></i>
                  <span>Thêm laptop mới</span>
                </a>
                <a href="/admin/create-user" class="admin-quick-action">
                  <i class="fas fa-user-plus text-success"></i>
                  <span>Tạo tài khoản mới</span>
                </a>
                <a href="/admin/order" class="admin-quick-action">
                  <i class="fas fa-clipboard-list text-warning"></i>
                  <span>Xử lý đơn hàng</span>
                </a>
                <a href="/" target="_blank" class="admin-quick-action">
                  <i class="fas fa-store text-info"></i>
                  <span>Mở cửa hàng (Client)</span>
                </a>
              </div>
            </div>

            <!-- Khu vực quản lý chi tiết & Trạng thái hệ thống -->
            <div class="row g-4">
              <!-- Cột trái: Các phân hệ quản trị chính -->
              <div class="col-lg-8">
                <div class="admin-content-card">
                  <div class="admin-card-heading">
                    <div>
                      <h2>Phân hệ quản trị</h2>
                      <span>Truy cập nhanh vào các chức năng cốt lõi</span>
                    </div>
                  </div>
                  <div class="p-4">
                    <div class="row g-3">
                      <!-- Phân hệ người dùng -->
                      <div class="col-md-4">
                        <div class="p-3 rounded-3 border bg-light h-100 d-flex flex-column justify-content-between">
                          <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                              <span class="badge bg-primary-subtle text-primary border p-2 rounded-2">
                                <i class="fas fa-user-shield"></i>
                              </span>
                              <strong class="text-dark">Người dùng</strong>
                            </div>
                            <p class="text-muted small mb-3">
                              Quản lý danh sách tài khoản, thông tin cá nhân và phân quyền hệ thống.
                            </p>
                          </div>
                          <a href="/admin/user" class="btn btn-outline-primary btn-sm w-100 fw-bold">
                            Quản lý (<%= (typeof info !== 'undefined' && info?.countUser !== undefined) ? info.countUser : 0 %>)
                          </a>
                        </div>
                      </div>

                      <!-- Phân hệ sản phẩm -->
                      <div class="col-md-4">
                        <div class="p-3 rounded-3 border bg-light h-100 d-flex flex-column justify-content-between">
                          <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                              <span class="badge bg-info-subtle text-info border p-2 rounded-2">
                                <i class="fas fa-laptop-code"></i>
                              </span>
                              <strong class="text-dark">Sản phẩm</strong>
                            </div>
                            <p class="text-muted small mb-3">
                              Cập nhật cấu hình, hình ảnh, đơn giá và số lượng tồn kho từng dòng laptop.
                            </p>
                          </div>
                          <a href="/admin/product" class="btn btn-outline-primary btn-sm w-100 fw-bold">
                            Quản lý (<%= (typeof info !== 'undefined' && info?.countProduct !== undefined) ? info.countProduct : 0 %>)
                          </a>
                        </div>
                      </div>

                      <!-- Phân hệ đơn hàng -->
                      <div class="col-md-4">
                        <div class="p-3 rounded-3 border bg-light h-100 d-flex flex-column justify-content-between">
                          <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                              <span class="badge bg-success-subtle text-success border p-2 rounded-2">
                                <i class="fas fa-box-open"></i>
                              </span>
                              <strong class="text-dark">Đơn hàng</strong>
                            </div>
                            <p class="text-muted small mb-3">
                              Kiểm tra thông tin giao nhận, trạng thái thanh toán và chi tiết sản phẩm đã mua.
                            </p>
                          </div>
                          <a href="/admin/order" class="btn btn-outline-primary btn-sm w-100 fw-bold">
                            Quản lý (<%= (typeof info !== 'undefined' && info?.countOrder !== undefined) ? info.countOrder : 0 %>)
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Cột phải: Trạng thái máy chủ & Môi trường -->
              <div class="col-lg-4">
                <div class="admin-content-card mb-4">
                  <div class="admin-card-heading">
                    <div>
                      <h2>Hệ thống</h2>
                      <span>Trạng thái hoạt động</span>
                    </div>
                  </div>
                  <div class="p-3">
                    <ul class="admin-system-status">
                      <li class="admin-system-item">
                        <span class="admin-system-label">
                          <i class="fas fa-database text-primary"></i> Cơ sở dữ liệu
                        </span>
                        <span class="admin-system-value text-success">
                          <span class="admin-pulse-dot me-1"></span> Hoạt động
                        </span>
                      </li>
                      <li class="admin-system-item">
                        <span class="admin-system-label">
                          <i class="fas fa-server text-info"></i> Máy chủ Web
                        </span>
                        <span class="admin-system-value">Node.js Express</span>
                      </li>
                      <li class="admin-system-item">
                        <span class="admin-system-label">
                          <i class="fas fa-layer-group text-warning"></i> ORM / DB
                        </span>
                        <span class="admin-system-value">Prisma Client</span>
                      </li>
                      <li class="admin-system-item">
                        <span class="admin-system-label">
                          <i class="fas fa-store text-success"></i> Cửa hàng online
                        </span>
                        <span class="admin-system-value text-success">Sẵn sàng</span>
                      </li>
                    </ul>
                  </div>
                </div>

                <div class="p-3 rounded-3 bg-white border shadow-sm">
                  <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="fas fa-shield-alt text-primary fs-5"></i>
                    <strong class="text-dark">Bảo mật &amp; Quản trị</strong>
                  </div>
                  <p class="text-muted small mb-0">
                    Bạn đang đăng nhập với quyền Quản trị viên. Hãy chú ý kiểm tra đơn hàng thường xuyên để đảm bảo tiến độ giao hàng cho khách hàng.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </main>
        <%- include('../layout/footer') -%>
      </div>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
    <script src="/admin/js/scripts.js"></script>
  </body>
</html>

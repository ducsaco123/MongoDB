<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta name="description" content="Dự án laptopshop" />
    <% 
      const orderInfo = (typeof order !== "undefined" && order && order.orderDetails) 
        ? order 
        : ((typeof order !== "undefined" && order && order.order) ? order.order : order);
      const items = (typeof order !== "undefined" && order && order.orderDetails && Array.isArray(order.orderDetails))
        ? order.orderDetails
        : ((typeof order !== "undefined" && order && order.product) ? [order] : []);
      const orderId = orderInfo?.id || (typeof id !== "undefined" ? id : "");
    %>
    <title>Chi tiết đơn hàng #<%= orderId %> | Laptopshop</title>
    <link href="/admin/css/styles.css" rel="stylesheet" />
    <link href="/admin/css/modern.css" rel="stylesheet" />
    <script
      src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"
      crossorigin="anonymous"
    ></script>
  </head>

  <body class="sb-nav-fixed admin-order">
    <%- include('../layout/header') -%>

    <div id="layoutSidenav">
      <%- include('../layout/sidenav') -%>
      <div id="layoutSidenav_content">
        <main>
          <div class="container-fluid px-4">
            <!-- Tiêu đề trang & Breadcrumb -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div class="admin-page-heading mb-3">
                <span class="admin-eyebrow">QUẢN LÝ ĐƠN HÀNG</span>
                <h1>Chi tiết đơn hàng #<%= orderId %></h1>
                <p>Xem thông tin chi tiết người nhận và các sản phẩm trong đơn hàng.</p>
              </div>
              <div>
                <a href="/admin/order" class="btn btn-outline-secondary">
                  <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                </a>
              </div>
            </div>

            <ol class="breadcrumb mb-4">
              <li class="breadcrumb-item"><a href="/admin">Bảng điều khiển</a></li>
              <li class="breadcrumb-item"><a href="/admin/order">Đơn hàng</a></li>
              <li class="breadcrumb-item active">Chi tiết #<%= orderId %></li>
            </ol>

            <!-- Card 1: Thông tin người nhận & Đơn hàng -->
            <div class="admin-content-card mb-4">
              <div class="admin-card-heading">
                <div>
                  <h2>Thông tin giao nhận &amp; Thanh toán</h2>
                  <span>Mã đơn: #<%= orderId %></span>
                </div>
                <div>
                  <% if (orderInfo?.status === 'PENDING') { %>
                    <span class="admin-badge-status admin-badge-pending">
                      <i class="fas fa-clock"></i> Chờ xử lý
                    </span>
                  <% } else if (orderInfo?.status === 'COMPLETED') { %>
                    <span class="admin-badge-status admin-badge-success">
                      <i class="fas fa-check-double"></i> Đã hoàn thành
                    </span>
                  <% } else if (orderInfo?.status === 'CANCELLED') { %>
                    <span class="admin-badge-status admin-badge-danger">
                      <i class="fas fa-ban"></i> Đã hủy
                    </span>
                  <% } else { %>
                    <span class="admin-badge-status admin-badge-info">
                      <%= orderInfo?.status || 'Chờ xử lý' %>
                    </span>
                  <% } %>
                </div>
              </div>

              <div class="p-4">
                <div class="row g-4">
                  <!-- Cột trái: Thông tin người nhận -->
                  <div class="col-md-6 border-end-md">
                    <h5 class="fw-bold mb-3 text-primary">
                      <i class="fas fa-user-check me-2"></i>Người nhận hàng
                    </h5>
                    <div class="mb-3">
                      <div class="admin-info-label">Họ và tên người nhận</div>
                      <div class="admin-info-value fs-6">
                        <%= orderInfo?.receiverName || (orderInfo?.user ? orderInfo?.user.fullName : '---') %>
                      </div>
                    </div>
                    <div class="mb-3">
                      <div class="admin-info-label">Số điện thoại liên hệ</div>
                      <div class="admin-info-value">
                        <%= orderInfo?.receiverPhone || (orderInfo?.user ? orderInfo?.user.phone : '---') %>
                      </div>
                    </div>
                    <div class="mb-0">
                      <div class="admin-info-label">Địa chỉ nhận hàng</div>
                      <div class="admin-info-value">
                        <%= orderInfo?.receiverAddress || '---' %>
                      </div>
                    </div>
                  </div>

                  <!-- Cột phải: Thông tin đơn hàng & Thanh toán -->
                  <div class="col-md-6">
                    <h5 class="fw-bold mb-3 text-primary">
                      <i class="fas fa-receipt me-2"></i>Chi tiết thanh toán
                    </h5>
                    <div class="mb-3">
                      <div class="admin-info-label">Tài khoản đặt hàng</div>
                      <div class="admin-info-value">
                        <%= orderInfo?.user ? orderInfo.user.fullName : 'Khách vãng lai' %>
                        <% if (orderInfo?.user?.email || orderInfo?.user?.username) { %>
                          <span class="text-muted fw-normal">
                            (<%= orderInfo.user.email || orderInfo.user.username %>)
                          </span>
                        <% } %>
                      </div>
                    </div>
                    <div class="row g-2 mb-3">
                      <div class="col-sm-6">
                        <div class="admin-info-label">Phương thức thanh toán</div>
                        <div class="admin-info-value mt-1">
                          <% if (orderInfo?.paymentMethod === 'COD') { %>
                            <span class="admin-badge-status admin-badge-info">
                              <i class="fas fa-money-bill-wave"></i> COD (Tiền mặt)
                            </span>
                          <% } else if (orderInfo?.paymentMethod === 'BANKING') { %>
                            <span class="admin-badge-status admin-badge-info">
                              <i class="fas fa-qrcode"></i> Chuyển khoản QR
                            </span>
                          <% } else { %>
                            <span class="admin-badge-status admin-badge-info">
                              <%= orderInfo?.paymentMethod || 'COD' %>
                            </span>
                          <% } %>
                        </div>
                      </div>
                      <div class="col-sm-6">
                        <div class="admin-info-label">Trạng thái thanh toán</div>
                        <div class="admin-info-value mt-1">
                          <% if (orderInfo?.paymentStatus === 'PAYMENT_PAID') { %>
                            <span class="admin-badge-status admin-badge-success">
                              <i class="fas fa-check-circle"></i> Đã thanh toán
                            </span>
                          <% } else { %>
                            <span class="admin-badge-status admin-badge-danger">
                              <i class="fas fa-times-circle"></i> Chưa thanh toán
                            </span>
                          <% } %>
                        </div>
                      </div>
                    </div>
                    <div>
                      <div class="admin-info-label">Tổng giá trị đơn hàng</div>
                      <div class="admin-info-value fs-5 text-primary">
                        <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(orderInfo?.totalPrice || 0) %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card 2: Danh sách sản phẩm trong đơn hàng (Read-only) -->
            <div class="admin-content-card mb-4">
              <div class="admin-card-heading">
                <div>
                  <h2>Danh sách sản phẩm</h2>
                  <span><%= items.length %> sản phẩm trong đơn hàng</span>
                </div>
              </div>

              <div class="table-responsive">
                <table class="table table-hover align-middle">
                  <thead>
                    <tr>
                      <th scope="col" style="width: 80px;">Ảnh</th>
                      <th scope="col">Tên sản phẩm</th>
                      <th scope="col" class="text-end">Đơn giá</th>
                      <th scope="col" class="text-center" style="width: 120px;">Số lượng</th>
                      <th scope="col" class="text-end" style="width: 160px;">Thành tiền</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (items && items.length > 0) { %>
                      <% items.forEach((item) => { %>
                        <tr>
                          <td>
                            <img
                              src="/images/product/<%= item.product ? item.product.image : '' %>"
                              alt="<%= item.product ? item.product.name : 'Sản phẩm' %>"
                              class="admin-order-product-img"
                              onerror="this.src='/images/product/default.png'"
                            />
                          </td>
                          <td>
                            <div class="d-flex flex-column">
                              <% if (item.product && item.product.factory) { %>
                                <span class="badge bg-light text-secondary border align-self-start mb-1" style="font-size: 0.7rem;">
                                  <%= item.product.factory %>
                                </span>
                              <% } %>
                              <strong class="text-dark">
                                <%= item.product ? item.product.name : 'Sản phẩm không xác định' %>
                              </strong>
                              <% if (item.productId) { %>
                                <small class="text-muted">Mã SP: #<%= item.productId %></small>
                              <% } %>
                            </div>
                          </td>
                          <td class="text-end">
                            <span class="text-secondary fw-semibold">
                              <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.price) %>
                            </span>
                          </td>
                          <td class="text-center">
                            <span class="badge bg-light text-dark border px-3 py-2 fs-6 fw-bold">
                              <%= item.quantity %>
                            </span>
                          </td>
                          <td class="text-end">
                            <span class="admin-price fs-6">
                              <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.price * item.quantity) %>
                            </span>
                          </td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="5" class="admin-table-empty">
                          Không có sản phẩm nào trong đơn hàng này.
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>

              <!-- Tổng kết thanh toán -->
              <div class="admin-order-summary-box">
                <div class="admin-order-summary-content">
                  <div class="admin-order-summary-row">
                    <span>Tạm tính hàng hóa:</span>
                    <strong class="text-dark">
                      <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(orderInfo?.totalPrice || 0) %>
                    </strong>
                  </div>
                  <div class="admin-order-summary-row">
                    <span>Phí giao hàng:</span>
                    <span class="text-success fw-bold">Miễn phí</span>
                  </div>
                  <div class="admin-order-summary-total">
                    <strong>Tổng tiền thanh toán:</strong>
                    <span class="total-amount">
                      <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(orderInfo?.totalPrice || 0) %>
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Nút điều hướng chân trang -->
            <div class="d-flex justify-content-end mb-4">
              <a href="/admin/order" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách đơn hàng
              </a>
            </div>
          </div>
        </main>
        <%- include('../layout/footer') -%>
      </div>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
    <script src="/admin/js/scripts.js"></script>
  </body>
</html>

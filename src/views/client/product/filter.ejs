<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Danh Sách Sản Phẩm | Laptopshop</title>
    <meta name="description" content="Tìm kiếm và chọn lọc laptop theo hãng sản xuất, mức giá và nhu cầu sử dụng tại Laptopshop" />

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />

    <!-- Core Stylesheet -->
    <link href="/client/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/client/css/style.css" rel="stylesheet" />
    <link href="/client/css/modern.css" rel="stylesheet" />
  </head>

  <body class="storefront filter-page">
    <!-- Spinner -->
    <div
      id="spinner"
      class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50 d-flex align-items-center justify-content-center"
    >
      <div class="spinner-grow text-primary" role="status"></div>
    </div>

    <%- include('../layout/header') -%>

    <main class="filter-main">
      <div class="container">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="filter-breadcrumb">
          <a href="/"><i class="fas fa-home me-1"></i> Trang chủ</a>
          <i class="fas fa-chevron-right"></i>
          <span>Danh sách sản phẩm</span>
        </nav>

        <!-- Header -->
        <div class="filter-header">
          <span class="section-kicker">TÌM KIẾM & BỘ LỌC</span>
          <h1>Danh Sách Sản Phẩm</h1>
          <p>Lọc laptop theo thương hiệu, mức ngân sách và nhu cầu công việc của bạn.</p>
        </div>

        <div class="row g-4" id="filter-results">
          <!-- Sidebar Bộ Lọc -->
          <div class="col-12 col-md-4 col-lg-3">
            <aside class="filter-sidebar-card">
              <div class="filter-sidebar-header">
                <h2 class="filter-sidebar-title">
                  <i class="fas fa-sliders-h" aria-hidden="true"></i>
                  <span>Bộ lọc tìm kiếm</span>
                </h2>
                <a href="/product" class="filter-reset-link" title="Xóa tất cả bộ lọc">
                  <i class="fas fa-undo-alt" aria-hidden="true"></i>
                  <span>Đặt lại</span>
                </a>
              </div>

              <form action="/product" method="get" id="filterForm">
                <!-- Nhóm 1: Hãng sản xuất -->
                <div class="filter-group" id="factoryFilter">
                  <div class="filter-group-label">
                    <span>Hãng sản xuất</span>
                    <i class="fas fa-tag text-muted" aria-hidden="true"></i>
                  </div>
                  <div class="filter-options-grid">
                    <label class="filter-check" for="factory-1">
                      <input class='form-check-input' type="checkbox" id="factory-1" name="factory" value="APPLE" />
                      <span class="filter-check-label">Apple</span>
                    </label>
                    <label class="filter-check" for="factory-2">
                      <input class='form-check-input' type="checkbox" id="factory-2" name="factory" value="ASUS" />
                      <span class="filter-check-label">Asus</span>
                    </label>
                    <label class="filter-check" for="factory-3">
                      <input class='form-check-input' type="checkbox" id="factory-3" name="factory" value="LENOVO" />
                      <span class="filter-check-label">Lenovo</span>
                    </label>
                    <label class="filter-check" for="factory-4">
                      <input class='form-check-input' type="checkbox" id="factory-4" name="factory" value="DELL" />
                      <span class="filter-check-label">Dell</span>
                    </label>
                    <label class="filter-check" for="factory-5">
                      <input class='form-check-input' type="checkbox" id="factory-5" name="factory" value="LG" />
                      <span class="filter-check-label">LG</span>
                    </label>
                    <label class="filter-check" for="factory-6">
                      <input class='form-check-input' type="checkbox" id="factory-6" name="factory" value="ACER" />
                      <span class="filter-check-label">Acer</span>
                    </label>
                  </div>
                </div>

                <!-- Nhóm 2: Mục đích sử dụng -->
                <div class="filter-group" id="targetFilter">
                  <div class="filter-group-label">
                    <span>Mục đích sử dụng</span>
                    <i class="fas fa-laptop text-muted" aria-hidden="true"></i>
                  </div>
                  <div class="filter-options-grid">
                    <label class="filter-check" for="target-1">
                      <input class='form-check-input' type="checkbox" id="target-1" name="target" value="GAMING" />
                      <span class="filter-check-label">Gaming</span>
                    </label>
                    <label class="filter-check" for="target-2">
                      <input class='form-check-input' type="checkbox" id="target-2" name="target" value="SINHVIEN-VANPHONG" />
                      <span class="filter-check-label">Sinh viên - văn phòng</span>
                    </label>
                    <label class="filter-check" for="target-3">
                      <input class='form-check-input' type="checkbox" id="target-3" name="target" value="THIET-KE-DO-HOA" />
                      <span class="filter-check-label">Thiết kế đồ họa</span>
                    </label>
                    <label class="filter-check" for="target-4">
                      <input class='form-check-input' type="checkbox" id="target-4" name="target" value="MONG-NHE" />
                      <span class="filter-check-label">Mỏng nhẹ</span>
                    </label>
                    <label class="filter-check" for="target-5">
                      <input class='form-check-input' type="checkbox" id="target-5" name="target" value="DOANH-NHAN" />
                      <span class="filter-check-label">Doanh nhân</span>
                    </label>
                  </div>
                </div>

                <!-- Nhóm 3: Mức giá -->
                <div class="filter-group" id="priceFilter">
                  <div class="filter-group-label">
                    <span>Mức giá</span>
                    <i class="fas fa-coins text-muted" aria-hidden="true"></i>
                  </div>
                  <div class="filter-options-grid">
                    <label class="filter-check" for="price-2">
                      <input class='form-check-input' type="checkbox" id="price-2" name="price" value="duoi-10-trieu" />
                      <span class="filter-check-label">Dưới 10 triệu</span>
                    </label>
                    <label class="filter-check" for="price-3">
                      <input class='form-check-input' type="checkbox" id="price-3" name="price" value="10-15-trieu" />
                      <span class="filter-check-label">Từ 10 - 15 triệu</span>
                    </label>
                    <label class="filter-check" for="price-4">
                      <input class='form-check-input' type="checkbox" id="price-4" name="price" value="15-20-trieu" />
                      <span class="filter-check-label">Từ 15 - 20 triệu</span>
                    </label>
                    <label class="filter-check" for="price-5">
                      <input class='form-check-input' type="checkbox" id="price-5" name="price" value="tren-20-trieu" />
                      <span class="filter-check-label">Trên 20 triệu</span>
                    </label>
                  </div>
                </div>

                <!-- Nhóm 4: Sắp xếp -->
                <div class="filter-group">
                  <div class="filter-group-label">
                    <span>Sắp xếp</span>
                    <i class="fas fa-sort-amount-down text-muted" aria-hidden="true"></i>
                  </div>
                  <div class="filter-options-grid">
                    <label class="filter-check" for="sort-1">
                      <input class='form-check-input' type="radio" id="sort-1" name="radio-sort" value="gia-tang-dan" />
                      <span class="filter-check-label">Giá tăng dần</span>
                    </label>
                    <label class="filter-check" for="sort-2">
                      <input class='form-check-input' type="radio" id="sort-2" name="radio-sort" value="gia-giam-dan" />
                      <span class="filter-check-label">Giá giảm dần</span>
                    </label>
                    <label class="filter-check" for="sort-3">
                      <input class='form-check-input' type="radio" id="sort-3" name="radio-sort" value="gia-khong-sap-xep" checked />
                      <span class="filter-check-label">Không sắp xếp</span>
                    </label>
                  </div>
                </div>

                <!-- Nút Submit -->
                <button type="submit" id="btnFilter" class="filter-btn-apply">
                  <i class="fas fa-filter" aria-hidden="true"></i>
                  <span>Lọc Sản Phẩm</span>
                </button>
              </form>
            </aside>
          </div>

          <!-- Danh sách sản phẩm bên phải -->
          <div class="col-12 col-md-8 col-lg-9">
            <!-- Thanh thông tin kết quả -->
            <div class="filter-content-bar">
              <div class="filter-count-info">
                <i class="fas fa-laptop" aria-hidden="true"></i>
                <span>Hiển thị <strong><%= products.length %></strong> sản phẩm</span>
              </div>
              <% if (products.length > 0 && typeof totalPages !== 'undefined' && totalPages > 0) { %>
                <span class="filter-page-indicator">
                  <i class="fas fa-layer-group me-1" aria-hidden="true"></i>
                  Trang <%= Math.min(page, totalPages) %> / <%= totalPages %>
                </span>
              <% } else { %>
                <span class="filter-page-indicator filter-page-indicator--empty">
                  <i class="fas fa-info-circle me-1" aria-hidden="true"></i>
                  0 kết quả
                </span>
              <% } %>
            </div>

            <!-- Grid Card Sản Phẩm -->
            <div class="row g-4">
              <% products.forEach((product) => { %>
                <div class="col-sm-6 col-lg-4">
                  <article class="product-card">
                    <a class="product-image" href="/product/<%= product.id %>" aria-label="Xem chi tiết <%= product.name %>">
                      <span class="product-chip">Laptop</span>
                      <img src="/images/product/<%= product.image %>" alt="<%= product.name %>" loading="lazy" />
                    </a>
                    <div class="product-card-body">
                      <span class="product-eyebrow"><%= product.factory %></span>
                      <h3><a href="/product/<%= product.id %>"><%= product.name %></a></h3>
                      <p class="product-description"><%= product.shortDesc %></p>
                      <div class="product-card-bottom">
                        <div class="product-price-box">
                          <strong class="product-price"><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.price) %></strong>
                        </div>
                        <form action="/add-product-to-cart/<%= product.id %>" method="post" class="product-cart-form">
                          <button data-product-id="<%= product.id %>" type="submit" class="btnAddToCartHomepage product-add-cart" aria-label="Thêm <%= product.name %> vào giỏ hàng" title="Thêm vào giỏ hàng">
                            <i class="fas fa-cart-plus" aria-hidden="true"></i>
                            <span>Add to cart</span>
                          </button>
                        </form>
                      </div>
                    </div>
                  </article>
                </div>
              <% }); %>

              <% if (!products.length) { %>
                <div class="col-12">
                  <div class="catalog-empty">
                    <div class="catalog-empty-icon">
                      <i class="fas fa-search" aria-hidden="true"></i>
                    </div>
                    <h3>Không tìm thấy sản phẩm phù hợp</h3>
                    <p>Hãy thử thay đổi tiêu chí lọc hoặc xóa bộ lọc để xem toàn bộ danh sách laptop hiện có.</p>
                    <div class="catalog-empty-actions">
                      <a href="/product" class="catalog-empty-btn">
                        <i class="fas fa-redo-alt" aria-hidden="true"></i>
                        <span>Xem tất cả sản phẩm</span>
                      </a>
                      <% if (typeof page !== 'undefined' && page > 1) { %>
                        <a href="/product?page=1" class="catalog-empty-btn-outline">
                          <i class="fas fa-arrow-left" aria-hidden="true"></i>
                          <span>Quay lại trang 1</span>
                        </a>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% } %>
            </div>

            <!-- Phân trang Pagination -->
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
              <div class="catalog-pagination-wrapper">
                <div class="catalog-pagination-info">
                  <span>Đang hiển thị trang <strong><%= page %></strong> trên tổng số <strong><%= totalPages %></strong> trang</span>
                </div>
                <nav aria-label="Phân trang danh sách sản phẩm" class="catalog-pagination-nav">
                  <ul class="catalog-pagination">
                    <!-- Nút trang trước -->
                    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                      <% if (page <= 1) { %>
                        <span class="page-link" aria-disabled="true" aria-label="Trang trước">
                          <i class="fas fa-chevron-left" aria-hidden="true"></i>
                        </span>
                      <% } else { %>
                        <a class="page-link" href="/product?page=<%= page - 1 %>#filter-results" aria-label="Trang trước">
                          <i class="fas fa-chevron-left" aria-hidden="true"></i>
                        </a>
                      <% } %>
                    </li>

                    <!-- Danh sách các trang rút gọn thông minh -->
                    <% 
                      const delta = 2;
                      const range = [];
                      const rangeWithDots = [];
                      let lastItem;

                      for (let i = 1; i <= totalPages; i++) {
                        if (i === 1 || i === totalPages || (i >= page - delta && i <= page + delta)) {
                          range.push(i);
                        }
                      }

                      for (let i of range) {
                        if (lastItem) {
                          if (i - lastItem === 2) {
                            rangeWithDots.push(lastItem + 1);
                          } else if (i - lastItem !== 1) {
                            rangeWithDots.push('...');
                          }
                        }
                        rangeWithDots.push(i);
                        lastItem = i;
                      }
                    %>

                    <% rangeWithDots.forEach((p) => { %>
                      <% if (p === '...') { %>
                        <li class="page-item disabled ellipsis">
                          <span class="page-link" aria-hidden="true">&hellip;</span>
                        </li>
                      <% } else if (p === page) { %>
                        <li class="page-item active" aria-current="page">
                          <span class="page-link"><%= p %></span>
                        </li>
                      <% } else { %>
                        <li class="page-item">
                          <a class="page-link" href="/product?page=<%= p %>#filter-results"><%= p %></a>
                        </li>
                      <% } %>
                    <% }); %>

                    <!-- Nút trang sau -->
                    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                      <% if (page >= totalPages) { %>
                        <span class="page-link" aria-disabled="true" aria-label="Trang sau">
                          <i class="fas fa-chevron-right" aria-hidden="true"></i>
                        </span>
                      <% } else { %>
                        <a class="page-link" href="/product?page=<%= page + 1 %>#filter-results" aria-label="Trang sau">
                          <i class="fas fa-chevron-right" aria-hidden="true"></i>
                        </a>
                      <% } %>
                    </li>
                  </ul>
                </nav>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </main>

    <%- include('../layout/footer') -%>

    <!-- Back to Top -->
    <a href="#" class="back-to-top" aria-label="Lên đầu trang">
      <i class="fas fa-arrow-up" aria-hidden="true"></i>
    </a>

    <!-- JavaScript Libraries -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/client/lib/easing/easing.min.js"></script>
    <script src="/client/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="/client/js/main.js"></script>
  </body>
</html>
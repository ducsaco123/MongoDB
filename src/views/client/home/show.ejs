<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Khám phá laptop tại Laptopshop" />
    <title>Laptopshop | Khám phá laptop phù hợp với bạn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="/client/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/client/css/style.css" rel="stylesheet" />
    <link href="/client/css/modern.css" rel="stylesheet" />
  </head>
  <body class="storefront">
    <%- include('../layout/header') -%>
    <main>
      <%- include('../layout/banner') -%>
      <%- include('../layout/feature') -%>
      <section class="catalog-section" id="san-pham">
        <div class="container">
          <div class="catalog-heading">
            <div>
              <span class="section-kicker">KHÁM PHÁ BỘ SƯU TẬP</span>
              <h2>Laptop nổi bật</h2>
              <p>Chọn chiếc máy phù hợp với công việc và phong cách của bạn.</p>
            </div>
            <span class="catalog-count">
              <i class="fas fa-layer-group" aria-hidden="true"></i>
              <% if (products.length > 0 && typeof totalPages !== 'undefined' && totalPages > 0) { %>
                Trang <%= Math.min(page, totalPages) %> / <%= totalPages %>
              <% } else { %>
                0 sản phẩm
              <% } %>
            </span>
          </div>
          <div class="row g-4">
            <% products.forEach((product) => { %>
              <div class="col-sm-6 col-lg-4 col-xl-3">
                <article class="product-card">
                  <a class="product-image" href="/product/<%= product.id %>" aria-label="Xem chi tiết <%= product.name %>">
                    <span class="product-chip">Laptop</span>
                    <img src="/images/product/<%= product.image %>" alt="<%= product.name %>" loading="lazy" />
                  </a>
                  <div class="product-card-body">
                    <span class="product-eyebrow"><%= product.factory %></span>
                    <h3><a href="/product/<%= product.id %>"><%= product.name %></a></h3>
                    <p class="product-description"><%= product.shortDesc %></p>
                    <div class="product-card-bottom">
                      <div class="product-price-box">
                        <strong class="product-price"><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.price) %></strong>
                      </div>
                      <form action="/add-product-to-cart/<%= product.id %>" method="post" class="product-cart-form">
                        <button data-product-id="<%= product.id %>" type="submit" class="btnAddToCartHomepage product-add-cart" aria-label="Thêm <%= product.name %> vào giỏ hàng" title="Thêm vào giỏ hàng">
                          <i class="fas fa-cart-plus" aria-hidden="true"></i>
                          <span>Add to cart</span>
                        </button>
                      </form>
                    </div>
                  </div>
                </article>
              </div>
            <% }); %>
          </div>

          <% if (!products.length) { %>
            <div class="catalog-empty">
              <div class="catalog-empty-icon">
                <i class="fas fa-laptop" aria-hidden="true"></i>
              </div>
              <h3>Chưa có sản phẩm</h3>
              <p>Danh sách laptop hiện chưa có sản phẩm nào trên trang này.</p>
              <% if (typeof page !== 'undefined' && page > 1) { %>
                <div class="catalog-empty-actions">
                  <a href="/#san-pham" class="catalog-empty-btn">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    <span>Trở về trang 1</span>
                  </a>
                </div>
              <% } %>
            </div>
          <% } %>

          <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <div class="catalog-pagination-wrapper">
              <div class="catalog-pagination-info">
                <span>Đang hiển thị trang <strong><%= page %></strong> trên tổng số <strong><%= totalPages %></strong> trang</span>
              </div>
              <nav aria-label="Phân trang sản phẩm" class="catalog-pagination-nav">
                <ul class="catalog-pagination">
                  <!-- Nút trang trước -->
                  <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                    <% if (page <= 1) { %>
                      <span class="page-link" aria-disabled="true" aria-label="Trang trước">
                        <i class="fas fa-chevron-left" aria-hidden="true"></i>
                      </span>
                    <% } else { %>
                      <a class="page-link" href="/?page=<%= page - 1 %>#san-pham" aria-label="Trang trước">
                        <i class="fas fa-chevron-left" aria-hidden="true"></i>
                      </a>
                    <% } %>
                  </li>

                  <!-- Danh sách các trang với thuật toán rút gọn trang thông minh -->
                  <% 
                    const delta = 2;
                    const range = [];
                    const rangeWithDots = [];
                    let lastItem;

                    for (let i = 1; i <= totalPages; i++) {
                      if (i === 1 || i === totalPages || (i >= page - delta && i <= page + delta)) {
                        range.push(i);
                      }
                    }

                    for (let i of range) {
                      if (lastItem) {
                        if (i - lastItem === 2) {
                          rangeWithDots.push(lastItem + 1);
                        } else if (i - lastItem !== 1) {
                          rangeWithDots.push('...');
                        }
                      }
                      rangeWithDots.push(i);
                      lastItem = i;
                    }
                  %>

                  <% rangeWithDots.forEach((p) => { %>
                    <% if (p === '...') { %>
                      <li class="page-item disabled ellipsis">
                        <span class="page-link" aria-hidden="true">&hellip;</span>
                      </li>
                    <% } else if (p === page) { %>
                      <li class="page-item active" aria-current="page">
                        <span class="page-link"><%= p %></span>
                      </li>
                    <% } else { %>
                      <li class="page-item">
                        <a class="page-link" href="/?page=<%= p %>#san-pham"><%= p %></a>
                      </li>
                    <% } %>
                  <% }); %>

                  <!-- Nút trang kế tiếp -->
                  <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                    <% if (page >= totalPages) { %>
                      <span class="page-link" aria-disabled="true" aria-label="Trang sau">
                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                      </span>
                    <% } else { %>
                      <a class="page-link" href="/?page=<%= page + 1 %>#san-pham" aria-label="Trang sau">
                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                      </a>
                    <% } %>
                  </li>
                </ul>
              </nav>
            </div>
          <% } %>
        </div>
      </section>
    </main>
    <%- include('../layout/footer') -%>
    <a href="#" class="back-to-top" aria-label="Lên đầu trang"><i class="fas fa-arrow-up"></i></a>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/client/lib/easing/easing.min.js"></script>
    <script src="/client/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="/client/js/main.js"></script>
  </body>
</html>
